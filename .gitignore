.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
out/
output/
build/
dist/
.DS_Store
kaizen-workspace/

# Local credentials, review databases, and SQLite sidecars are never application source.
.env
.env.*
!.env.example
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.ses
*.ses-*

# Supplied BD source folders stay on the reviewer's machine.
/Attachment I- BOM/
/BOM cross check Folder/
/SKUs/

# The hackathon brief is BD-internal material; keep it local, never in the public repo.
docs/reference/*.pdf

# Customer-provided BD source data stays local. Public tests use extraction fixtures.
trainingdataset/
tmp/real-data/
# Anything derived from it that names BD documents or transcribes their content stays local too:
# the private regression suite and the detailed findings (the public summary is docs/real-data-validation.md).
tests/real/
docs/private/

# Third-party agent skills installed with `npx skills add` (not part of the product)
.claude/skills/
.claude/launch.json
.claude/settings.json
.playwright-mcp/
.hallmark/
skills-lock.json
